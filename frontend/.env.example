# Dev: where the Vite dev server forwards /api (the backend's PORT)
VITE_BACKEND_URL=http://localhost:8000

# Production only: the backend origin, no trailing slash, when it is on a different
# domain from the frontend. Leave unset when /api is served from the same origin.
# VITE_API_URL=https://api.joinclub.example

# Optional: a Sentry DSN enables frontend error reporting. Empty: errors only show the fallback page.
# VITE_SENTRY_DSN=https://example@sentry.io/project

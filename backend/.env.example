# Copy to .env and fill in. Only SECRET_KEY, MONGO_URI and PORT are required to boot.

# --- Core (required) ---
# Connection string. May name the database itself: mongodb://127.0.0.1:27017/joinclub
MONGO_URI=mongodb://127.0.0.1:27017/joinclub
# Optional: overrides the database named in MONGO_URI. Leave empty unless you need it.
MONGO_DB=
# Signs the auth cookie and reset tokens. Use a long random string: openssl rand -hex 32
SECRET_KEY=change_me_to_a_long_random_string
PORT=8000
# "production" enables Secure/SameSite=None cookies and makes the seed script refuse to run
NODE_ENV=development
# Request-log level: trace, debug, info, warn, error, silent
LOG_LEVEL=info

# --- Frontend / CORS ---
# Comma-separated list of allowed origins. The app origin must be one of them.
CLIENT_URL=http://localhost:5173

# --- Cloudinary (profile photos, resumes, club logos). Without it, uploads return 503. ---
CLOUD_NAME=
API_KEY=
API_SECRET=

# --- Email (OTP codes for password reset/change and email verification) ---
# Leave SMTP_HOST empty in development: codes are then printed in the server console.
# Gmail: smtp.gmail.com, port 587, and an App Password (not the account password).
# Gmail allows roughly 500 messages a day, which a recruitment week can exceed; a
# transactional provider (Brevo or Resend free tier) is the fix, and both speak SMTP, so
# only these values change. See docs/runbooks/ for the deliverability notes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=JoinClub PEC <no-reply@joinclub.pec>
# Only allow student sign-ups from @<STUDENT_EMAIL_DOMAIN>, e.g. pec.edu.in. Empty: any email.
STUDENT_EMAIL_DOMAIN=
# Set to false to let unverified students apply while you are testing locally.
REQUIRE_EMAIL_VERIFICATION=true

# --- AI assistant ---
# Empty key: the assistant runs in a free demo mode that answers from the database.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_SMALL_MODEL=claude-haiku-4-5
# Messages per hour, logged-in students / guests.
AI_HOURLY_LIMIT=40
AI_GUEST_HOURLY_LIMIT=8

# --- Error monitoring (optional) ---
# Empty: nothing is reported and nothing leaves the machine. Set it to a Sentry DSN to
# receive 5xx errors. Cookies, auth headers and request bodies are stripped before sending.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- Rate limiting ---
# "mongo" (default) keeps the counters in MongoDB, so they survive a restart and are
# shared if the host runs more than one instance. "memory" is faster and per-process.
RATE_LIMIT_STORE=mongo

# --- Admin accounts (used by npm run seed) ---
# Club admins are created as <club>.admin@<ADMIN_EMAIL_DOMAIN>.
ADMIN_EMAIL_DOMAIN=joinclub.pec
SUPER_ADMIN_EMAIL=admin@joinclub.pec
# Empty: the seed generates one and writes it to output/club-admin-credentials.csv.
SUPER_ADMIN_PASSWORD=
